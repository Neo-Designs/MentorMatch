<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MentorMatch</title>

    <!-- No-flash theme: apply theme BEFORE stylesheets paint to avoid a light/dark flicker on load.
         Falls back to the user's OS color-scheme preference on first visit, then remembers their toggle. -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
                var theme = saved || (prefersLight ? 'light' : 'dark');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MentorMatch.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">Skip to main content</a>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark glass-nav mb-3" aria-label="Primary">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    MentorMatch
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="Dashboard">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="Profile">My Profile</a>
                                </li>
                            }
                            else if (User.IsInRole("Supervisor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Supervisor" asp-action="Dashboard">Review Projects</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Supervisor" asp-action="MyMatches">Matched Projects</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">My Profile</a>
                                </li>
                            }
                            else if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Analytics">Analytics</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Allocations">Allocations</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Management
                                    </a>
                                    <ul class="dropdown-menu glass-nav p-2 border-white border-opacity-10" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item small" asp-controller="Admin" asp-action="Users">Users</a></li>
                                        <li><a class="dropdown-item small" asp-controller="Admin" asp-action="Whitelist">Invites</a></li>
                                        <li><hr class="dropdown-divider border-white border-opacity-10"></li>
                                        <li><a class="dropdown-item small" asp-controller="Admin" asp-action="Tags">Tags</a></li>
                                        <li><a class="dropdown-item small" asp-controller="Admin" asp-action="Modules">Modules</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        <button id="theme-toggle" type="button"
                                class="btn btn-link nav-link p-2 me-2 theme-toggle-btn"
                                title="Toggle theme" aria-label="Toggle color theme" aria-pressed="false">
                            <i class="bi bi-moon-stars fs-5" id="theme-icon" aria-hidden="true"></i>
                        </button>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main id="main-content" role="main" class="pb-3 page-fade-in">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success glass-card py-2 px-4 mb-4 border-success border-opacity-25 text-success small"
                     role="status" aria-live="polite">
                    <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i> @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger glass-card py-2 px-4 mb-4 border-danger border-opacity-25 text-danger small"
                     role="alert" aria-live="assertive">
                    <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i> @TempData["Error"]
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>