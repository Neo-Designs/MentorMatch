@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@*
    MentorMatch login partial.
    Sits on the right of the navbar. Shows either:
      - auth actions (Register / Login) when signed out
      - an account chip + Logout button when signed in
    Styling comes from site.css (.nav-link / .glass-button). No hardcoded colours.
*@

<ul class="navbar-nav align-items-center gap-1 mb-0">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link d-inline-flex align-items-center gap-2"
               asp-area="Identity" asp-page="/Account/Manage/Index"
               title="Manage your account" aria-label="Manage your account">
                <i class="bi bi-person-circle" aria-hidden="true"></i>
                <span class="d-none d-md-inline">@User.Identity?.Name</span>
            </a>
        </li>
        <li class="nav-item">
            <form class="d-inline m-0"
                  asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">
                <button type="submit"
                        class="nav-link btn btn-link d-inline-flex align-items-center gap-2"
                        title="Sign out" aria-label="Sign out">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    <span class="d-none d-md-inline">Logout</span>
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link d-inline-flex align-items-center gap-2"
               asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus" aria-hidden="true"></i>
                <span>Register</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link d-inline-flex align-items-center gap-2"
               asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                <span>Login</span>
            </a>
        </li>
    }
</ul>
