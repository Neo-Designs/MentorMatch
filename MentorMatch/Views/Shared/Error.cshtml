@model ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Something went wrong";
}

@*
    MentorMatch — friendly global error view.
    Theme-aware (uses glass-card / glass-button tokens from site.css).
    Hides the "Development Mode" guidance in production so end users never see it.
*@

<section class="row justify-content-center py-5" role="alert" aria-live="assertive">
    <div class="col-md-8 col-lg-6">
        <div class="glass-card text-center">
            <i class="bi bi-exclamation-octagon-fill text-danger"
               style="font-size: 3rem;"
               aria-hidden="true"></i>

            <h1 class="mt-3 mb-2">Something went wrong</h1>
            <p class="text-muted mb-4">
                We hit a snag while processing your request. You can head back home or try again in a moment.
            </p>

            @if (Model?.ShowRequestId == true)
            {
                <div class="glass-card py-2 px-3 mb-4 d-inline-block text-start small"
                     style="max-width: 100%; word-break: break-all;">
                    <span class="text-muted me-1">Request ID:</span>
                    <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a class="glass-button" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill me-1" aria-hidden="true"></i> Go home
                </a>
                <a class="glass-button glass-button-blue"
                   href="javascript:history.back()"
                   role="button">
                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Go back
                </a>
            </div>
        </div>

        @if (Env.IsDevelopment())
        {
            <div class="glass-card mt-3 small text-muted" role="note">
                <h2 class="h6 mb-2">Development tip</h2>
                <p class="mb-2">
                    Set the <code>ASPNETCORE_ENVIRONMENT</code> environment variable to
                    <strong>Development</strong> and restart the app to see the full stack trace here.
                </p>
                <p class="mb-0">
                    <strong>Don't</strong> ship the app with the Development environment enabled —
                    it exposes sensitive exception details to end users.
                </p>
            </div>
        }
    </div>
</section>
