@{
    ViewData["Title"] = "Welcome";
}

<div class="row min-vh-75 align-items-center justify-content-center text-center py-5">
    <div class="col-lg-10 mb-5">
        <div class="animate-float mb-4">
            <span class="badge rounded-pill hero-badge mb-3">
                <i class="bi bi-shield-check me-2 text-info"></i> Connecting students with the right expertise
            </span>
        </div>
        <h1 class="display-1 fw-bold mb-4 hero-title">
            <span class="hero-text-match">Match</span> your project <br /> 
            with the perfect <span class="hero-text-mentor">Mentor</span>
        </h1>
        <p class="lead text-white mb-5 mx-auto" style="max-width: 800px; opacity: 0.7; font-weight: 300; letter-spacing: 0.01em;">
            MentorMatch ensures fair, expertise-driven pairing between student projects and supervisors through anonymous review and smart expertise algorithms.
        </p>
        <div class="d-flex gap-4 justify-content-center">
            <a href="/Identity/Account/Register" class="hero-btn hero-btn-primary hover-scale">Get Started Now</a>
            <a href="/Identity/Account/Login" class="hero-btn hover-scale">Sign In</a>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
