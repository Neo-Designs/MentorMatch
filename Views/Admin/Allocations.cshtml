@model IEnumerable<MentorMatch.Models.Proposal>
@{
    ViewData["Title"] = "Project Management";
}

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Project <span class="text-success">Management</span></h2>
            <p class="small text-muted mb-0">Assign and manage project-supervisor matches</p>
        </div>
        <div class="text-end">
            <div class="small text-white-50">Total Projects: @Model.Count()</div>
            <div class="small text-success">Active Matches: @Model.Count(p => p.Match != null)</div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 border-success border-opacity-25 text-success small mb-4">
            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover text-white align-middle">
            <thead class="text-muted small text-uppercase">
                <tr>
                    <th class="border-white border-opacity-10">Module</th>
                    <th class="border-white border-opacity-10">Project Title</th>
                    <th class="border-white border-opacity-10">Student</th>
                    <th class="border-white border-opacity-10">Supervisor</th>
                    <th class="border-white border-opacity-10">Status</th>
                    <th class="border-white border-opacity-10 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prop in Model)
                {
                    <tr>
                        <td class="border-white border-opacity-10">
                            <span class="badge bg-secondary opacity-75">@prop.Module.Code</span>
                        </td>
                        <td class="border-white border-opacity-10 fw-bold">@prop.Title</td>
                        <td class="border-white border-opacity-10 small">
                            @prop.Student.FirstName @prop.Student.LastName
                        </td>
                        <td class="border-white border-opacity-10 small">
                            @if (prop.Match != null)
                            {
                                <div class="d-flex align-items-center">
                                    <div class="bg-success rounded-circle me-2" style="width: 8px; height: 8px;"></div>
                                    @prop.Match.Supervisor.FirstName @prop.Match.Supervisor.LastName
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center text-white-50">
                                    <div class="bg-secondary rounded-circle me-2" style="width: 8px; height: 8px;"></div>
                                    <em class="text-black-dark">Unassigned</em>
                                </div>
                            }
                        </td>
                        <td class="border-white border-opacity-10">
                            @if (prop.Status == ProposalStatus.Matched)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Matched</span>
                            }
                            else if (prop.Status == ProposalStatus.UnderReview)
                            {
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">Under Review</span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">Pending</span>
                            }
                        </td>
                        <td class="border-white border-opacity-10 text-end">
                            <div class="d-flex justify-content-end gap-2">
                                @if (prop.Match != null)
                                {
                                    <form asp-action="DeleteMatch" method="post" onsubmit="return confirm('This will undo the match and return project to pending. Proceed?');" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@prop.Id" />
                                        <button type="submit" class="glass-button py-1 px-3 small text-danger border-danger border-opacity-25" title="Remove Match">
                                            <i class="bi bi-link-45deg"></i> Unmatch
                                        </button>
                                    </form>
                                    <button type="button" class="glass-button py-1 px-3 small text-info border-info border-opacity-25" 
                                            onclick="openReassignModal(@prop.Id, '@prop.Title.Replace("'", "\\'")', '@prop.Match.SupervisorId')">
                                        <i class="bi bi-arrow-repeat"></i> Reassign
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="glass-button py-1 px-3 small text-success border-success border-opacity-25" 
                                            onclick="openReassignModal(@prop.Id, '@prop.Title.Replace("'", "\\'")', '')">
                                        <i class="bi bi-plus-lg"></i> Assign
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Reassign/Assign Modal -->
<div class="modal fade" id="reassignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-white border-opacity-10 text-white">
            <div class="modal-header border-white border-opacity-10 bg-white bg-opacity-5">
                <h5 class="modal-title fw-bold text-black-dark" id="modalTitle">Manage Match</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ReassignMatch" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="proposalId" id="modalProposalId" />
                    <div class="mb-4">
                        <label class="form-label small text-muted text-uppercase mb-1">Project Title</label>
                        <p id="modalProjectTitle" class="fw-bold text-info mb-0 fs-5"></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase mb-1">Select Supervisor</label>
                        <select name="supervisorId" id="modalSupervisorSelect" class="form-select glass-nav border-white border-opacity-25 text-white py-2" required>
                            <option value="">-- Choose Supervisor --</option>
                            @foreach (var supervisor in ViewBag.Supervisors as List<MentorMatch.Models.ApplicationUser>)
                            {
                                <option value="@supervisor.Id">@supervisor.FirstName @supervisor.LastName</option>
                            }
                        </select>
                    </div>
                    <div class="bg-white bg-opacity-5 rounded p-3 small text-white-50">
                        <i class="bi bi-info-circle text-info me-2"></i> 
                        <span class="text-black-dark">Confirming this will notify the student and the selected supervisor automatically.</span>
                    </div>
                </div>
                <div class="modal-footer border-white border-opacity-10 bg-white bg-opacity-5">
                    <button type="button" class="glass-button py-2 px-4 small border-white border-opacity-10" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="glass-button glass-button-green py-2 px-4 small fw-bold">Confirm Allocation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script>
        function openReassignModal(proposalId, title, currentSupervisorId) {
            document.getElementById('modalProposalId').value = proposalId;
            document.getElementById('modalProjectTitle').innerText = title;
            document.getElementById('modalSupervisorSelect').value = currentSupervisorId;
            
            const modalTitle = currentSupervisorId ? 'Reassign Project' : 'Assign Project';
            document.getElementById('modalTitle').innerText = modalTitle;
            
            var modal = new bootstrap.Modal(document.getElementById('reassignModal'));
            modal.show();
        }
    </script>
}
